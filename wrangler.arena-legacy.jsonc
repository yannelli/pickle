{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "little-dill-arena",
  "account_id": "0b6cf9393bb1a493f7cf153100f0538f",
  "main": "server/arena-worker.mjs",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "vars": { "ARENA_UPSTREAM": "https://arena.littledill.app" },
  "durable_objects": { "bindings": [{ "name": "ARENAS", "class_name": "ArenaRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ArenaRoom"] }]
}
