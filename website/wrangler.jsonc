{
  "name": "little-dill-website",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": {
    "GAME_URL": "https://littledill.app"
  }
}
